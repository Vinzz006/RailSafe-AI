# ==============================================================================
# RailSafe AI Backend — Environment Configuration Template
# Copy this file to .env for local testing: cp .env.example .env
# NEVER commit .env or service account credentials to Git!
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Machine Learning Model Configuration
MODEL_PATH=models/railsafe_rf_model.pkl
MODEL_VERSION=1.0.0

# Firebase Authentication & Project Configuration
# In production on Google Cloud Run, Application Default Credentials (ADC) are resolved automatically.
# For local Docker runs requiring live Firebase validation, mount your service account JSON file:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=

# Development Auth Helper:
# Set to 'true' during offline/local testing to accept 'DEMO_OFFICER_TOKEN'
# MUST BE SET TO 'false' IN PRODUCTION ENVIRONMENTS!
ALLOW_DEV_AUTH_BYPASS=true

# Security & CORS (comma-separated origins)
CORS_ORIGINS=*
