# RailSafe AI Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Machine Learning Model Configuration
MODEL_PATH=models/railsafe_rf_model.pkl
MODEL_VERSION=1.0.0

# Firebase Configuration
# In production on Google Cloud Run, default application credentials (ADC) are used automatically.
# For local development with a service account file:
FIREBASE_PROJECT_ID=railsafe-ai
FIREBASE_SERVICE_ACCOUNT_PATH=

# Development Auth Helper:
# Set to 'true' only during local testing to accept 'DEMO_OFFICER_TOKEN' or 'dev-test-token'
# Always set to 'false' in production environments!
ALLOW_DEV_AUTH_BYPASS=true

# Security & CORS (comma-separated origins)
CORS_ORIGINS=*
