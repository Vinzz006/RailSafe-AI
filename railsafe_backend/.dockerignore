# Local Environment Variables and Secrets (CRITICAL: NEVER BAKE INTO IMAGE)
.env
.env.*
*.pem
*.key
*.cert
service-account*.json
credentials*.json
firebase-adminsdk*.json

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo

# Local logs and temporary files
*.log
logs/
tmp/
temp/

# Exclude test files from production runtime image
tests/
pytest.ini
