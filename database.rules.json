{
  "rules": {
    ".read": false,
    ".write": false,
    "railguard": {
      "alerts": {
        ".read": false,
        ".write": false,
        ".indexOn": ["created_at_ms", "review_status", "camera_id", "track_id", "event_uid"]
      },
      "event_uid_index": {
        ".read": false,
        ".write": false
      },
      "telemetry": {
        "$device_id": {
          ".read": false,
          ".write": false,
          ".indexOn": ["server_received_at_ms", "sequence"]
        }
      },
      "telemetry_latest": {
        "$device_id": {
          ".read": false,
          ".write": false
        }
      }
    }
  }
}
